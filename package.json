{
  "name": "opportunity-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev:start": "node scripts/dev-control.mjs start",
    "dev:stop": "node scripts/dev-control.mjs stop",
    "dev:status": "node scripts/dev-control.mjs status",
    "build": "next build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "next start -H 127.0.0.1",
    "test": "vitest run tests",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:load": "tsx scripts/load-profile.ts",
    "test:db": "tsx scripts/db-integration.ts",
    "test:smoke": "tsx scripts/smoke.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local --yes",
    "supabase:status": "supabase status -o pretty",
    "infra:start": "npm run supabase:start",
    "infra:stop": "npm run supabase:stop",
    "infra:reset": "node scripts/infra-reset.mjs",
    "infra:status": "npm run supabase:status",
    "test:watch": "vitest tests",
    "audit": "tsx scripts/audit.ts",
    "hunter:run": "tsx scripts/hunter.ts all",
    "hunter:jobs": "tsx scripts/hunter.ts jobs",
    "hunter:company": "tsx scripts/hunter.ts company",
    "hunter:bounty": "tsx scripts/hunter.ts bounty",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:seed": "tsx scripts/database.ts seed",
    "scheduler:simulate": "tsx scripts/scheduler.ts",
    "selfcheck": "node local-tests/selfcheck.mjs",
    "typecheck": "tsc --noEmit",
    "release:gate": "npm run lint && npm run format:check && npm test && npm run test:load && npm run test:db && npm run typecheck && npm run audit && npm run selfcheck && npm run build && npm run test:e2e && npm audit --audit-level=high"
  },
  "dependencies": {
    "@next/env": "^16.3.1",
    "@supabase/supabase-js": "2.112.3",
    "drizzle-orm": "0.45.2",
    "next": "16.3.1",
    "openai": "7.4.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "supabase": "2.114.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
